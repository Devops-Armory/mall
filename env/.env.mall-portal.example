#================================================================================
# ● Application Settings
#================================================================================
# SERVER_PORT=8085                          # 服务端口 (Default: 8085)
# SPRING_APPLICATION_NAME=mall-portal       # 应用名称 (Default: mall-portal)
# SPRING_MVC_PATHMATCH_STRATEGY=ant_path_matcher # 路径匹配策略 (Default: ant_path_matcher)


#================================================================================
# ● MySQL Database (Required)
#================================================================================
MYSQL_HOST=your-mysql-host.example.com         # MySQL主机地址，例如：mysql-mall-dev-sea-01.mysql.database.azure.com
MYSQL_USERNAME=your_mysql_user                 # MySQL用户名，例如：ashmmysql
MYSQL_PASSWORD=your_mysql_password             # MySQL密码
MYSQL_DATABASE=mall                            # 数据库名
# MYSQL_PORT=3306                              # MySQL端口 (Default: 3306)
# MYSQL_TIMEZONE=Asia/Shanghai                 # 时区设置 (Default: Asia/Shanghai)
MYSQL_USE_SSL=false                            # 启用SSL连接


#================================================================================
# ● Druid Connection Pool
#================================================================================
# DRUID_INITIAL_SIZE=5                     # 连接池初始化大小 (Default: 5)
# DRUID_MIN_IDLE=10                        # 最小空闲连接数 (Default: 10)
# DRUID_MAX_ACTIVE=20                      # 最大连接数 (Default: 20)
# DRUID_EXCLUSIONS="*.js,*.gif,*.jpg,*.png,*.css,*.ico,/druid/*" # 排除统计的请求 (Default: *.js,*.gif,...)
DRUID_LOGIN_USERNAME=druid                # 监控网页登录用户名
DRUID_LOGIN_PASSWORD=druid                # 监控网页登录密码


#================================================================================
# ● MongoDB (Required for portal)
#================================================================================
MONGO_HOST=mongodb                             # MongoDB服务器地址，例如：mongodb
# MONGO_PORT=27017                             # MongoDB端口 (Default: 27017)
MONGO_DATABASE=mall-portal                     # MongoDB数据库名 (Default: mall-portal)


#================================================================================
# ● Redis (Required)
#================================================================================
REDIS_HOST=your-redis-host.example.com         # Redis服务器地址，例如：mall.redis.cache.windows.net
REDIS_PASSWORD=your_redis_password             # Redis密码
# REDIS_PORT=6379                              # Redis端口 (Default: 6379)
# REDIS_DATABASE=0                             # Redis数据库索引 (Default: 0)
# REDIS_TIMEOUT=300ms                          # 连接超时时间 (Default: 300ms)


#================================================================================
# ● RabbitMQ (Required for portal)
#================================================================================
RABBITMQ_HOST=rabbitmq                         # RabbitMQ服务器地址，例如：rabbitmq
# RABBITMQ_PORT=5672                           # RabbitMQ端口 (Default: 5672)
# RABBITMQ_VIRTUAL_HOST=/mall                  # 虚拟主机 (Default: /mall)
RABBITMQ_USERNAME=your_rabbitmq_user           # RabbitMQ用户名
RABBITMQ_PASSWORD=your_rabbitmq_password       # RabbitMQ密码


#================================================================================
# ● JWT (JSON Web Token)
#================================================================================
JWT_SECRET=your-jwt-secret                     # JWT加解密密钥
# JWT_TOKEN_HEADER=Authorization               # JWT存储的请求头 (Default: Authorization)
# JWT_EXPIRATION=604800                        # JWT超期时间 (秒) (Default: 604800, 7天)
# JWT_TOKEN_HEAD='Bearer '                     # JWT负载中拿到的开头 (Default: 'Bearer ')


#================================================================================
# ● Redis Business Keys
#================================================================================
# REDIS_BUSINESS_DATABASE=mall             # 业务Redis数据库名 (Default: mall)
# REDIS_KEY_AUTH_CODE='ums:authCode'       # 验证码key前缀 (Default: 'ums:authCode')
# REDIS_KEY_ORDER_ID='oms:orderId'         # 订单ID key前缀 (Default: 'oms:orderId')
# REDIS_KEY_MEMBER='ums:member'            # 会员key前缀 (Default: 'ums:member')
# REDIS_EXPIRE_AUTH_CODE=90                # 验证码超期时间 (秒) (Default: 90)
# REDIS_EXPIRE_COMMON=86400                # 通用缓存有效期 (秒) (Default: 86400, 24小时)


#================================================================================
# ● Message Queue
#================================================================================
# RABBITMQ_QUEUE_CANCEL_ORDER=cancelOrderQueue # 取消订单队列名 (Default: cancelOrderQueue)


#================================================================================
# ● MongoDB Business
#================================================================================
# MONGO_INSERT_SQL_ENABLE=true                 # 是否通过数据库数据来插入mongo (Default: true)


#================================================================================
# ● Logging
#================================================================================
# LOG_FILE_PATH=/var/logs                      # 日志文件路径 (Default: /var/logs)
# LOG_LEVEL_ROOT=info                          # 根日志级别 (Default: info)
# LOG_LEVEL_MALL=info                          # mall包日志级别 (Default: info)


#================================================================================
# ● Logstash (Optional)
#================================================================================
LOGSTASH_HOST=logstash                        # Logstash主机地址 (e.g., 127.0.0.1:4560)


#================================================================================
# ● Alipay Payment (Optional)
#================================================================================
# ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do # 支付宝网关地址
ALIPAY_APP_ID=                            # 支付宝应用ID
ALIPAY_PUBLIC_KEY=                        # 支付宝公钥
ALIPAY_PRIVATE_KEY=                       # 应用私钥
ALIPAY_RETURN_URL=                        # 支付成功返回地址
ALIPAY_NOTIFY_URL=                        # 支付成功通知地址